# Exemplo local de configuração. Copie para .env e ajuste os valores.
# Todos os valores abaixo são exemplos locais; nenhum segredo real é usado.

# Perfil de execução: production, development ou integration.
# APP_ENV=production

# Identidade do serviço e da instância nos logs.
# SERVICE_NAME=distributed-wager-processing
# INSTANCE_ID=instance-1
# LOG_LEVEL=info

# PostgreSQL usado pela aplicação (role wager_app criada pelas migrações).
# DATABASE_URL=postgres://wager_app:wager_app_local@localhost:5432/wager?sslmode=disable

# Servidor HTTP e limites de recurso por instância.
# HTTP_ADDR=:8080
# HTTP_CONCURRENCY_LIMIT=256
# HTTP_MAX_BODY_BYTES=1048576

# IdP OIDC: issuer do realm importado e audience exigida nos tokens.
# OIDC_ISSUER_URL=http://keycloak:8080/realms/wager
# OIDC_AUDIENCE=wager-api

# SQS local (LocalStack) e filas provisionadas por cmd/provision.
# SQS_ENDPOINT=http://localhost:4566
# SQS_INGRESS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
# SQS_EVENT_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo
# SQS_CONSUMER_NAME=wager-transactions

# Identidades de provedor aceitas na fila de entrada (SenderId=providerId).
# SQS_PROVIDER_SENDER_IDS=sender-a=provider-a,sender-b=provider-b

# Credenciais locais do LocalStack (não use em produção).
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local

# Failpoints são aceitos apenas com APP_ENV=integration; produção os rejeita.
# FAILPOINTS=sqs.after_commit
